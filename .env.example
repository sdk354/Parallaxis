# Copy to .env and adjust. .env is gitignored.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=parallaxis
POSTGRES_USER=parallaxis
POSTGRES_PASSWORD=parallaxis

# Sent on every outbound request. Keep it named and contactable —
# see data-sources-compliance.md §6.
USER_AGENT=ParallaxisBot/0.1 (+https://github.com/sdk354/Parallaxis; academic research; contact via repository issues)

# Seconds between requests to the same host (data-sources-compliance.md §6).
CRAWL_DELAY=2.0
